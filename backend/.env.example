# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Speech-to-text model and the model that extracts form fields from the transcript
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_EXTRACT_MODEL=gemini-3.5-flash

# SMART removes filler words and formats numbers; VERBATIM keeps everything
TRANSCRIBE_MODE=SMART
# Comma-separated BCP-47 codes, e.g. en-IN,hi-IN. Empty = auto-detect.
TRANSCRIBE_LANGUAGES=

# SQLite database file (created on first run)
DATABASE_PATH=instance/campus_gate.sqlite3

# Remote order-verification server (another Flask app, not on this machine).
# Each saved order is POSTed here as JSON; it replies {"status": "accepted" | "not_accepted"}.
ORDER_VERIFY_URL=https://orders.example.com/api/verify-order
# Optional bearer token sent as "Authorization: Bearer <token>"
ORDER_VERIFY_TOKEN=
# Seconds to wait for its reply
ORDER_VERIFY_TIMEOUT=15

# Largest upload (audio or photo) accepted, in MB
MAX_UPLOAD_MB=25

# Origins allowed to call the API directly (the Vite dev proxy does not need this)
CORS_ORIGINS=http://localhost:5173

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
