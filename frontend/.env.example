# Flask backend (../backend). Vite proxies /api/* and /checkin/* to it in dev.
VITE_EXTRACT_BACKEND_URL=http://localhost:5000

# Optional: send /checkin/* somewhere else (defaults to the URL above)
VITE_CHECKIN_BACKEND_URL=

# Optional: call the servers directly instead of through the dev proxy
# (e.g. in a production build). Leave empty to use relative paths.
VITE_EXTRACT_API_BASE=
VITE_CHECKIN_API_BASE=
