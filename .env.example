# Flask server that transcribes the audio and extracts entities.
# Vite proxies /api/* to this address in dev.
VITE_EXTRACT_BACKEND_URL=http://localhost:5000

# Flask server that receives the check-in (snapshot + entities).
# Vite proxies /checkin/* to this address in dev.
VITE_CHECKIN_BACKEND_URL=http://localhost:5001

# Optional: call the servers directly instead of through the dev proxy
# (e.g. in a production build). Leave empty to use relative paths.
VITE_EXTRACT_API_BASE=
VITE_CHECKIN_API_BASE=
